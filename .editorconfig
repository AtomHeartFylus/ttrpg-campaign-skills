# The repo is markdown and stdlib Python; the only thing worth enforcing is that a diff of a
# skill is a diff of its wording, not of its whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
indent_size = 2
# markdown uses two trailing spaces as a line break; leave them alone
trim_trailing_whitespace = false
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{sh,ps1}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2
